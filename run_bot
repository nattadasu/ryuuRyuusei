#!/usr/bin/bash

# Bot startup script using uv
#
# Usage: ./run_bot
#
# This script will:
# 1. Pull latest changes
# 2. Sync dependencies (including dev)
# 3. Run firstRun.py for setup
# 4. Start the bot

cd "$(dirname "$0")" || exit 1
git pull
uv sync --all-groups --upgrade
uv run firstRun.py
uv run main.py
